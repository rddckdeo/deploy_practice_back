# 로컬 개발용 설정 템플릿
# 이 파일을 같은 폴더에 application-local.yml 로 복사한 뒤 값을 채우세요.
# application-local.yml 은 .gitignore 에 등록되어 있어 Git에 올라가지 않습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/practice_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: practice_user
    password:
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
